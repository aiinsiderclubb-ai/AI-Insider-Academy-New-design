# Copy to `.env.local` (git-ignored) and fill in for your environment.

# Where the Express API lives. Everything server-side calls `${API_ORIGIN}/api/…`,
# and the image optimiser allows this host so avatars and uploaded artwork load.
# Defaults to http://localhost:3001.
API_ORIGIN=http://localhost:3001

# Extra hosts the image optimiser may fetch from, comma-separated. A bare
# hostname is assumed to be https; give a full origin when the scheme or port
# matters. Anything not listed here — and not the API origin — is refused,
# which is what keeps `/_next/image` from being an open proxy.
#
#   IMAGE_HOSTS=cdn.example.com,https://media.example.com:8443
IMAGE_HOSTS=

# Absolute site URL, used for canonical links, sitemap and Open Graph.
# Defaults to https://myinsideracademy.com.
SITE_URL=http://localhost:4000

# Shared with the API (same value on Render). Lets this server pass each
# visitor's real address to the API, so its rate limits apply per visitor
# instead of to this server as a whole. Leave empty and nothing changes.
# Generate with:  openssl rand -hex 32
WEB_PROXY_SECRET=

# Cloudflare R2, where lesson videos live. Course content stores an object key
# (`first-automation-n8n/fn1.mp4`); the study page signs it into a URL that
# expires after a few hours, so a copied link stops working on its own. Lesson
# entries holding a `/public` path or a full URL are used as-is and need none
# of this.
#
# Leave these empty and a lesson with an object key shows the player's
# "video coming soon" frame instead of a link that would only 403.
#
# The account id is the hex string in the R2 endpoint Cloudflare shows you:
# https://<account-id>.r2.cloudflarestorage.com. The key pair comes from
# R2 → Manage API tokens, and needs read access only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
