{"id": "order-ok", "turns": ["Где мой заказ 5004? Почта ivan@example.com"], "expect": {"tools_include": ["get_order"], "reply_any": ["отправ", "20450000005004"]}, "note": "Совпадает email"}
{"id": "order-ask-email", "turns": ["Где заказ 5004?"], "expect": {"reply_any": ["email", "почт", "e-mail"], "reply_none": ["Подушка", "отправлен"]}, "note": "Нет email — спрашивает"}
