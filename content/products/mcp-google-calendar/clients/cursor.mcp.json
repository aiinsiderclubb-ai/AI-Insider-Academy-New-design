{
  "mcpServers": {
    "google-calendar": {
      "command": "python3",
      "args": [
        "${userHome}/mcp/google-calendar/server/calendar_mcp.py",
        "--config",
        "${userHome}/mcp/google-calendar/config/calendar.json"
      ],
      "env": {
        "GOOGLE_CLIENT_ID": "${env:GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${env:GOOGLE_CLIENT_SECRET}",
        "GOOGLE_REFRESH_TOKEN": "${env:GOOGLE_REFRESH_TOKEN}"
      }
    }
  }
}
