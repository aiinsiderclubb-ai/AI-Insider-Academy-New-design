    {
      "id": "8fa6f9a3-8c96-509c-a602-5b3ae10669aa",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "options": {
          "systemMessage": "Ты — рабочий ассистент компании. У тебя есть доступ к базе данных (только чтение), к GitHub (только чтение) и к HubSpot CRM.\n- Перед SQL-запросом посмотри схему через search_objects; не угадывай названия таблиц и колонок.\n- Запросы к базе — только SELECT, с LIMIT. Не показывай целиком персональные данные клиентов, если об этом не просили.\n- В HubSpot сначала покажи, что собираешься изменить, и меняй только после явного «да» пользователя.\n- Если данных не хватает — так и скажи, не придумывай цифры.",
          "maxIterations": 10
        }
      }
    },
