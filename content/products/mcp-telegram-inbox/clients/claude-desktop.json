{
  "mcpServers": {
    "telegram-inbox": {
      "command": "python3",
      "args": [
        "/ПОЛНЫЙ/ПУТЬ/К/НАБОРУ/server/telegram_inbox_mcp.py",
        "--config",
        "/ПОЛНЫЙ/ПУТЬ/К/НАБОРУ/config/inbox.json"
      ],
      "env": {
        "TELEGRAM_BOT_TOKEN": "ВСТАВЬТЕ_TELEGRAM_BOT_TOKEN",
        "CRM_WEBHOOK_TOKEN": "ВСТАВЬТЕ_CRM_WEBHOOK_TOKEN"
      }
    }
  }
}
