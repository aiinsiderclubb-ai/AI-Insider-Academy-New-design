      "prompt": {
        "prompt": "ВСТАВЬТЕ СЮДА ТЕКСТ ИЗ prompts/system-prompt.ru.md",
        "llm": "REPLACE_WITH_MODEL",
        "temperature": 0.3,
        "tool_ids": [
          "REPLACE_WITH_TOOL_ID_1",
          "REPLACE_WITH_TOOL_ID_2",
          "REPLACE_WITH_TOOL_ID_3",
          "REPLACE_WITH_TOOL_ID_4",
          "REPLACE_WITH_TOOL_ID_5",
          "REPLACE_WITH_TOOL_ID_6"
