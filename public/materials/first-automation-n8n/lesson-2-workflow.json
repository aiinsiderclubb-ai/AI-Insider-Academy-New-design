      "parameters": {
        "promptType": "define",
        "text": "=Ты — AI-классификатор входящих заявок потенциальных клиентов.\n\nПроанализируй ТОЛЬКО заявку ниже.\n\nТекст заявки:\n{{ $json.query.message }}\n\nОпредели:\n- category — одна из: Sales, Support, Partnership, Other\n- priority — одно из: LOW, MEDIUM, HIGH\n- summary — краткое резюме заявки в одном предложении\n\nНе объясняй свои рассуждения.\nНе давай рекомендации.\nНе описывай правила классификации.\nНе добавляй дополнительный текст.\nВерни исключительно JSON в формате:\n{\"category\": \"...\", \"priority\": \"...\", \"summary\": \"...\"}",
        "options": {}
      }
    },
    {
      "id": "a3",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        220,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
