        "options": {}
      }
    },
    {
      "id": "a4",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        0
      ],
      "parameters": {
        "jsCode": "const raw = $json.output;\n\nlet data;\n\ntry {\n  data = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\n    'AI вернул ответ не в формате JSON. Получено: ' + raw\n  );\n}\n\nif (!data.category) {\n  throw new Error('В ответе AI отсутствует поле category');\n}\n\nif (!data.priority) {\n  throw new Error('В ответе AI отсутствует поле priority');\n}\n\nif (!data.summary) {\n  throw new Error('В ответе AI отсутствует поле summary');\n}\n\nreturn [{ json: data }];"
      }
    },
